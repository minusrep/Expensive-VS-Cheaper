.menu-button {
    font-size: 48px;
    -unity-font-style: bold;
    background-color: rgb(28, 175, 238);
    color: rgb(255, 255, 255);
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Lilita%20One%20Russian.ttf?fileID=12800000&guid=e267750c3aa668d4bb105109891d5242&type=3#Lilita One Russian");
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    padding-right: 64px;
    padding-left: 64px;
    width: 320px;
}

.item {
    height: 100%;
    flex-grow: 0;
    width: 50%;
    flex-shrink: 0;
    position: absolute;
}

.control-button {
    width: 450px;
    height: 120px;
    background-color: rgb(11, 232, 129);
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=3ab00100b536c784a98e2f1ca92cc40b&type=3#LilitaOne-Regular");
    background-image: url("project://database/Assets/Content/Sprites/button.png?fileID=2800000&guid=16892b1c8c6beb9498a6f5bf74c93953&type=3#button");
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 2px;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.control-button Image {
    width: 64px;
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}




