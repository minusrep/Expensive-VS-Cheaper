.menu-button {
    font-size: 48px;
    -unity-font-style: bold;
    background-color: rgb(28, 175, 238);
    color: rgb(255, 255, 255);
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Lilita%20One%20Russian.ttf?fileID=12800000&guid=e267750c3aa668d4bb105109891d5242&type=3#Lilita One Russian");
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    padding-right: 64px;
    padding-left: 64px;
    width: 320px;
}

.item {
    background-color: rgb(178, 39, 39);
    height: 100%;
    flex-grow: 0;
    width: 50%;
    flex-shrink: 0;
    position: absolute;
}
