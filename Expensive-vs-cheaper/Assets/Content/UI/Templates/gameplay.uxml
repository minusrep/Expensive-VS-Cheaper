<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/core.uss?fileID=7433441132597879392&amp;guid=85897d362b8a26b41bd9c71446df5c35&amp;type=3#core"/>
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(64, 209, 251);">
        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="item" class="item" style="flex-grow: 0; translate: 0% 0; position: absolute; left: -50%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="buttons" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
            <ui:VisualElement name="space" style="flex-grow: 8;"/>
            <ui:VisualElement name="content" style="align-items: center;">
                <ui:Button text="More Expensive" name="more-expensive-button" icon-image="project://database/Assets/Content/Sprites/up.png?fileID=2800000&amp;guid=5acfca10838d3c44eb36ec04033346a0&amp;type=3#up" class="control-button" style="-unity-background-image-tint-color: rgb(11, 232, 129);"/>
                <ui:Button text="More Expensive" name="cheaper-button" icon-image="project://database/Assets/Content/Sprites/down.png?fileID=2800000&amp;guid=a8a25010e0b67d649b2f62a79a3629b3&amp;type=3#down" class="control-button" style="-unity-background-image-tint-color: rgb(255, 63, 52); color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
