<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/core.uss?fileID=7433441132597879392&amp;guid=85897d362b8a26b41bd9c71446df5c35&amp;type=3#core"/>
    <ui:VisualElement name="root" class="lose-menu" style="background-image: url(&quot;project://database/Assets/Content/Sprites/background_2.png?fileID=2800000&amp;guid=b4ca8f614adb32f4393b48dd188c14f0&amp;type=3#background_2&quot;);">
        <ui:VisualElement name="lose-menu-content" class="lose-menu__content">
            <ui:Label text="ВЫ ПРОИГРАЛИ!" name="lose-title" class="lose-menu__title"/>
            <ui:VisualElement name="lose-result-row" class="lose-menu__result-row">
                <ui:Label text="ЛУЧШИЙ РЕЗУЛЬТАТ:" name="best-result-label" class="lose-menu__result-label"/>
                <ui:Label text="0" name="best-result-value" class="lose-menu__result-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="lose-icon" class="lose-menu__icon">
                <ui:Label text="+" name="lose-icon-cross" class="lose-menu__icon-cross"/>
            </ui:VisualElement>
            <ui:Button text="ПОПРОБОВАТЬ ЕЩЁ" name="retry-button" class="lose-menu__button lose-menu__button--retry"/>
            <ui:Button text="X ВЫХОД" name="exit-button" class="lose-menu__button lose-menu__button--exit"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
